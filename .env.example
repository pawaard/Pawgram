APP_NAME=Pawgram
APP_ENV=development
APP_PORT=8000

# https://my.telegram.org adresinden alınır.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Özel müşteri paketinde yeni hesap ekleme ekranına otomatik gelen proxy.
# API anahtarı pakete eklenmez; yalnızca proxy bağlantı bilgileri kullanılır.
DEFAULT_PROXY_TYPE=socks5
DEFAULT_PROXY_HOST=
DEFAULT_PROXY_PORT=
DEFAULT_PROXY_USERNAME=
DEFAULT_PROXY_PASSWORD=
# Özel müşteri paketi üretirken otomatik oluşturulur; elle girilmez.
DEFAULT_PROXY_REVISION=

# Üretimde uzun ve rastgele bir değer kullanın.
APP_SECRET_KEY=change-this-in-production

# Ticari pakette true yapılır. Özel sunucu adresi üretimde HTTPS olmalıdır.
LICENSE_REQUIRED=false
LICENSE_SERVER_URL=http://127.0.0.1:8010
LICENSE_REQUEST_TIMEOUT=8
LICENSE_CHECK_INTERVAL_MINUTES=30
