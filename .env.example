APP_NAME=Pawgram
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# https://my.telegram.org adresinden alınır.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Üretimde uzun ve rastgele bir değer kullanın.
APP_SECRET_KEY=change-this-in-production

# Ticari pakette true yapılır. Özel sunucu adresi üretimde HTTPS olmalıdır.
LICENSE_REQUIRED=false
LICENSE_SERVER_URL=http://127.0.0.1:8010
LICENSE_REQUEST_TIMEOUT=8
LICENSE_CHECK_INTERVAL_MINUTES=30
